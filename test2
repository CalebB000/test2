local function Euleon_Cleanup()
    removeWall()
    
    if targetDeathConnection then
        targetDeathConnection:Disconnect()
        targetDeathConnection = nil
    end
    
    for key, _ in pairs(beamDefaults) do
        beamDefaults[key] = nil
    end
    
    hairDestroyed = false
    if lplr.Character then
        RestoreHairAndAccessories(lplr.Character)
    end
    
    camlockActive = false
    camlockTarget = nil
    speedwalkActive = false
    jumpowerActive = false
    bypassVoidDesyncActive = false
    teleportTarget = nil
    
    -- Reset camera to player
    pcall(function()
        if lplr and lplr.Character then
            c.CameraSubject = lplr.Character:FindFirstChild("Humanoid")
        end
    end)
    
    -- Stop animation
    if currentAnimationTrack then
        pcall(function() currentAnimationTrack:Stop() end)
        currentAnimationTrack = nil
    end
    
    for _, conn in ipairs(Euleon_Connections) do pcall(function() conn:Disconnect() end) end
    for _, draw in ipairs(Euleon_Drawings) do pcall(function() draw:Remove() end) end
    Euleon_Connections = {}
    Euleon_Drawings = {}
    beamDefaults = {}
    monitoredPlayers = {}
    getgenv().Euleonload = nil
    getgenv().Euleon_Cleanup = nil
end


local R15_PARTS = {
    "Head", "UpperTorso", "LowerTorso",
    "LeftUpperArm", "LeftLowerArm", "LeftHand",
    "RightUpperArm", "RightLowerArm", "RightHand",
    "LeftUpperLeg", "LeftLowerLeg", "LeftFoot",
    "RightUpperLeg", "RightLowerLeg", "RightFoot",
}

local function GetMouseVP()
    local mouse = uis:GetMouseLocation()
    return Vector2.new(mouse.X, mouse.Y)
end

local function BasicPoint(part)
    if not part then return nil end
    return part.Position + part.CFrame.UpVector * (part.Size.Y / 2)
end

local function GetClosestPointInternal(character, cp_cfg, ref_x, ref_y)
    if not (character and character.Parent) then return nil end
    local mode    = cp_cfg["Mode"] or "Advanced"
    local scale   = cp_cfg["Scale"] or 5.5
    local density = math.clamp(cp_cfg["Density"] or 2, 1, 4)
    local sf      = math.clamp(scale, 0, 10) / 10
    local bd      = 1e9
    local bp, bpos
    local parts = {}
    for i = 1, #R15_PARTS do
        local part = character:FindFirstChild(R15_PARTS[i])
        if part and part:IsA("BasePart") then
            parts[#parts+1] = part
        end
    end
    if mode == "Basic" then
        for i = 1, #parts do
            local cl = BasicPoint(parts[i])
            if cl then
                local s = c:WorldToViewportPoint(cl)
                if s.Z > 0 then
                    local d = (s.X-ref_x)^2 + (s.Y-ref_y)^2
                    if d < bd then bd=d; bp=parts[i]; bpos=cl end
                end
            end
        end
    else
        local so = {}
        for j = 0, density-1 do so[j+1] = j / math.max(density-1, 1) end
        for i = 1, #parts do
            local part = parts[i]
            local size = part.Size
            local half = size * 0.5
            local cf   = part.CFrame
            local sh   = half * (1 - sf)
            for z = 1, density do
                local lz = math.clamp(-half.Z + so[z]*size.Z, -sh.Z, sh.Z)
                for y = 1, density do
                    local ly = math.clamp(-half.Y + so[y]*size.Y, -sh.Y, sh.Y)
                    for x = 1, density do
                        local lx = math.clamp(-half.X + so[x]*size.X, -sh.X, sh.X)
                        local wp = cf:PointToWorldSpace(Vector3.new(lx,ly,lz))
                        local s  = c:WorldToViewportPoint(wp)
                        if s.Z > 0 then
                            local d = (s.X-ref_x)^2 + (s.Y-ref_y)^2
                            if d < bd then bd=d; bp=part; bpos=wp end
                        end
                    end
                end
            end
        end
    end
    if bp then return {Part=bp, Position=bpos} end
    local root = character:FindFirstChild("HumanoidRootPart")
    return root and {Part=root, Position=root.Position}
end

local function GetClosestPoint(character, cp_cfg)
    if not character or not cp_cfg or not cp_cfg["Enabled"] then return nil end
    local mv = GetMouseVP()
    return GetClosestPointInternal(character, cp_cfg, mv.X, mv.Y)
end

local function GetClosestPart(character)
    if not character then return nil end
    local bestPart = nil
    local bestDist = math.huge
    local mv = GetMouseVP()
    
    for _, partName in ipairs(R15_PARTS) do
        local part = character:FindFirstChild(partName)
        if part and part:IsA("BasePart") then
            local screen = c:WorldToViewportPoint(part.Position)
            if screen.Z > 0 then
                local dist = (Vector2.new(screen.X, screen.Y) - mv).Magnitude
                if dist < bestDist then
                    bestDist = dist
                    bestPart = part
                end
            end
        end
    end
    
    return bestPart
end

local function GetVelocity(character)
    if not character then return Vector3.new(0,0,0) end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    return hrp and hrp.AssemblyLinearVelocity or Vector3.new(0,0,0)
end

local function ApplyPrediction(position, velocity, pred_cfg, distance)
    if not position or not velocity then return position end
    if not pred_cfg or type(pred_cfg) ~= "table" then return position end
    if not pred_cfg["Enabled"] then return position end
    local scalar = pred_cfg["Basic"] or 0
    return position + velocity * scalar
end

-- Camlock Functions
local function GetCamlockPosition(character, distance)
    if not character then return nil end
    local cfg = cfg_camlock()
    if not cfg then return nil end
    
    local result = nil
    pcall(function()
        local closestMode = cfg["ClosestMode"]
        local position = nil
        
        -- Get position using selected mode
        if closestMode then
            local mode = closestMode["Mode"] or "part"
            
            if mode == "point" then
                -- Closest point mode - advanced raycasting
                local cp_cfg = {
                    ["Enabled"] = true,
                    ["Mode"] = "Advanced",
                    ["Scale"] = closestMode["PointScale"] or 5.5,
                    ["Density"] = closestMode["PointDensity"] or 2,
                }
                local cp = GetClosestPoint(character, cp_cfg)
                if cp then position = cp.Position end
            elseif mode == "HeadOnly" then
                -- Head only mode
                local head = character:FindFirstChild("Head")
                if head and head:IsA("BasePart") then
                    position = head.Position
                end
            else
                -- Closest part mode
                local part = GetClosestPart(character)
                if part then position = part.Position end
            end
        end
        
        -- Fallback to head
        if not position then
            local head = character:FindFirstChild("Head")
            if head and head:IsA("BasePart") then
                position = head.Position
            end
        end
        
        -- Fallback to HRP
        if not position then
            local hrp = character:FindFirstChild("HumanoidRootPart")
            if hrp then position = hrp.Position end
        end
        
        -- Apply prediction
        if position then
            local velocity = GetVelocity(character)
            result = ApplyPrediction(position, velocity, cfg["Prediction"], distance or 0)
        end
    end)
    return result
end

local function GetCamlockDistance(target)
    if not target or not target.Character then return math.huge end
    local hrp = target.Character:FindFirstChild("HumanoidRootPart")
    if not hrp or not lplr.Character then return math.huge end
    local lhrp = lplr.Character:FindFirstChild("HumanoidRootPart")
    if not lhrp then return math.huge end
    return (hrp.Position - lhrp.Position).Magnitude
end

local function IsInCamlockFOV(target)
    if not target or not target.Character then return false end
    local cfg = cfg_camlock()
    if not cfg or not cfg["ShowFOV"] then return true end
    local hrp = target.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local screen, onScreen = c:WorldToViewportPoint(hrp.Position)
    if not onScreen then return false end
    local mouse = uis:GetMouseLocation()
    local distance = (Vector2.new(screen.X, screen.Y) - mouse).Magnitude
    return distance <= (cfg["Radius"] or 100)
end

local function WorldToScreen(position)
    local screenPos, onScreen = c:WorldToViewportPoint(position)
    return Vector2.new(screenPos.X, screenPos.Y), onScreen and screenPos.Z > 0
end

local function GetClosestPlayerInFOV()
    local fov = getgenv().Euleon["Silent"]["FOV"]["Radius"]
    local closestPlayer = nil
    local closestDist = fov
    local mousePos = uis:GetMouseLocation()
    local player_hrp = lplr.Character and lplr.Character:FindFirstChild("HumanoidRootPart")
    
    if not player_hrp then return nil end
    
    local player_pos = player_hrp.Position
    local max_range = 240  -- HARD LIMIT: 240 studs max range
    
    for _, player in pairs(GetPlayers()) do
        if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then continue end
        
        if not IsAlive(player) then continue end
        
        local target_pos = player.Character.HumanoidRootPart.Position
        local world_dist = (target_pos - player_pos).Magnitude
        
        if world_dist > max_range then continue end
        
        local isWhitelisted = false
        for _, whitelistedName in pairs(_G.ESPWhitelistedPlayers) do
            if whitelistedName == player.Name then
                isWhitelisted = true
                break
            end
        end
        if isWhitelisted then continue end
        
        local screenPos, onScreen = WorldToScreen(target_pos)
        if not onScreen then continue end
        
        local dist = (screenPos - mousePos).Magnitude
        if dist < closestDist then
            closestDist = dist
            closestPlayer = player
        end
    end
    
    return closestPlayer
end


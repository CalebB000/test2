-- BypassVoidUsers Spectate Loop
table.insert(Euleon_Connections, rs.Heartbeat:Connect(function()
    if not (bypassVoidDesyncActive and getgenv().Euleon["Movement"]["Teleport"]["Enabled"]) then
        return
    end
    
    if not lplr or not lplr.Character or not teleportTarget or not teleportTarget.Character then
        bypassVoidDesyncActive = false
        teleportTarget = nil
        pcall(function() c.CameraSubject = lplr.Character:FindFirstChild("Humanoid") end)
        return
    end

    local lhrp = lplr.Character:FindFirstChild("HumanoidRootPart")
    local targetHRP = teleportTarget.Character:FindFirstChild("HumanoidRootPart")
    local targetHumanoid = teleportTarget.Character:FindFirstChild("Humanoid")

    if not lhrp or not targetHRP or not targetHumanoid then
        bypassVoidDesyncActive = false
        teleportTarget = nil
        pcall(function() c.CameraSubject = lplr.Character:FindFirstChild("Humanoid") end)
        return
    end

    -- Check if key is still being held
    local userInputService = game:GetService("UserInputService")
    if not userInputService:IsKeyDown(getgenv().Euleon["Movement"]["Teleport"]["BypassVoidUsersKey"]) then
        -- Key released - stop spectating
        bypassVoidDesyncActive = false
        teleportTarget = nil
        pcall(function() c.CameraSubject = lplr.Character:FindFirstChild("Humanoid") end)
        return
    end
    
    -- Spectate the target
    c.CameraSubject = targetHumanoid
    
    -- Orbit around target
    bypassVoidOrbitAngle = bypassVoidOrbitAngle + 0.05
    local orbitX = math.cos(bypassVoidOrbitAngle) * bypassVoidOrbitRadius
    local orbitZ = math.sin(bypassVoidOrbitAngle) * bypassVoidOrbitRadius
    local orbitOffset = Vector3.new(orbitX, 0, orbitZ)
    
    -- Move player to orbit around target (server sees you orbiting)
    lhrp.CFrame = targetHRP.CFrame + orbitOffset
end))

-- BypassVoidUsers CFrame lock (keeps camera position fixed during orbit desync)
local bypassVoidStoredCFrame = nil
local bypassVoidCFrameHook
bypassVoidCFrameHook = hookmetamethod(game, "__index", newcclosure(function(self, key)
    if not checkcaller() and bypassVoidDesyncActive then
        if key == "CFrame" and self == lplr.Character:FindFirstChild("HumanoidRootPart") then
            if bypassVoidStoredCFrame then
                return bypassVoidStoredCFrame
            end
        end
    end
    return bypassVoidCFrameHook(self, key)
end))


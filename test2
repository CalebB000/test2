local function DestroyHairAndAccessories(character)
    if not character then return end
    
    
    local head = character:FindFirstChild("Head")
    if not head then return end
    
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") and part.Name == "Hair" then
            pcall(function() part:Destroy() end)
        end
    end
    
    for _, acc in ipairs(character:GetChildren()) do
        if acc:IsA("Accessory") then
            local handle = acc:FindFirstChild("Handle")
            if handle then
                local weld = handle:FindFirstChild("AccessoryWeld") or handle:FindFirstChildOfClass("Weld")
                if weld then
                    local part0 = weld.Part0
                    local part1 = weld.Part1
                    
                    if (part0 and part0.Name == "Head") or (part1 and part1.Name == "Head") then
                        pcall(function() acc:Destroy() end)
                    end
                end
            end
        end
    end
end


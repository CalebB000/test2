table.insert(Euleon_Connections, rs.RenderStepped:Connect(function()
    if not camlockActive or not getgenv().Euleon["Camlock"]["Enabled"] then return end
    
    local cam_cfg = cfg_camlock()
    if not cam_cfg then return end
    
    local checks_cfg = cfg_checks()
    
    -- Check if current target is still valid
    if camlockTarget and camlockTarget.Character then
        local humanoid = camlockTarget.Character:FindFirstChildOfClass("Humanoid")
        
        -- Drop target if dead
        if not humanoid or humanoid.Health <= 0 then
            camlockTarget = nil
            return
        end
        
        -- Drop target if K.O Check enabled and target is K.O'd
        if checks_cfg and checks_cfg["K.OCheck"] then
            if not IsAlive(camlockTarget) then
                camlockTarget = nil
                return
            end
        end
        
        -- Drop target if VisibleCheck enabled and target is hidden
        if checks_cfg and checks_cfg["VisibleCheck"] then
            local be = camlockTarget.Character:FindFirstChild("BodyEffects")
            if be then
                if be:FindFirstChild("K.O") and be["K.O"].Value == true then
                    camlockTarget = nil
                    return
                end
                if be:FindFirstChild("Dead") and be["Dead"].Value == true then
                    camlockTarget = nil
                    return
                end
            end
        end
        
        -- Apply camlock to current target ONLY (not closest to cursor)
        local lhrp = lplr.Character and lplr.Character:FindFirstChild("HumanoidRootPart")
        if not lhrp then return end
        
        local thrp = camlockTarget.Character:FindFirstChild("HumanoidRootPart")
        if not thrp then return end
        
        -- WallCheck: Only check if we should apply camlock, but DON'T drop target
        -- This allows targeting behind wall and re-locking when they come out
        local canApplyCamlock = true
        if checks_cfg and checks_cfg["WallCheck"] then
            if not CamlockWallCheck(camlockTarget) then
                -- Behind wall - don't apply camlock this frame, but keep target
                canApplyCamlock = false
            end
        end
        
        -- Only apply camlock if all checks pass
        if canApplyCamlock then
            local distance = (thrp.Position - lhrp.Position).Magnitude
            local targetPos = GetCamlockPosition(camlockTarget.Character, distance)
            
            if targetPos then
                local smoothness = cam_cfg["Smoothness"] or 0.15
                local mode = cam_cfg["Mode"] or "Camera"
                
                if mode == "Camera" then
                    local newCFrame = CFrame.lookAt(c.CFrame.p, targetPos)
                    c.CFrame = c.CFrame:Lerp(newCFrame, smoothness)
                elseif mode == "Mouse" then
                    local screen, onScreen = c:WorldToViewportPoint(targetPos)
                    if onScreen and screen.Z > 0 then
                        local mousePos = uis:GetMouseLocation()
                        local diffX = screen.X - mousePos.X
                        local diffY = screen.Y - mousePos.Y
                        
                        local mouseSmoothness = smoothness * 5
                        mouseSmoothness = math.min(mouseSmoothness, 1)
                        
                        if math.abs(diffX) > 0.5 or math.abs(diffY) > 0.5 then
                            local moveX = diffX * mouseSmoothness
                            local moveY = diffY * mouseSmoothness
                            mousemoverel(moveX, moveY)
                        end
                    end
                end
            end
        end
        -- If behind wall, just maintain camera position (no lerp, no snap)
    else
        -- No target, don't do anything
        return
    end
end))


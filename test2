if gun_handler_active then
    local orig_shoot = gun_handler.shoot
    local ClientBulletHooked = false
    local lastHitsoundTime = 0
    local hitsoundCooldown = 0.2  -- Prevent playing more than once per 0.2 seconds
    
    local function HookClientBullet()
        if ClientBulletHooked then return end
        
        gun_handler.shoot = function(args)
            if not getgenv().Euleon["Silent"]["RevClientBulletRedirection"]["Enabled"] then
                return orig_shoot(args)
            end
            
            -- SNAP CAMERA TO TARGET if gunMacroTarget is active
            local originalCFrame = c.CFrame
            if gunMacroTarget and gunMacroTarget.Character then
                local targetHRP = gunMacroTarget.Character:FindFirstChild("HumanoidRootPart")
                if targetHRP then
                    c.CFrame = CFrame.new(c.CFrame.Position, targetHRP.Position)
                end
            end
            
            -- SKIP UpdateCachedAim if gunMacroTarget is active - use cached aim directly
            if not (ik_executing and gunMacroTarget) then
                UpdateCachedAim()
            end
            
            -- Wall positioning for Der Hood only
            if isDerHood and not IsRevolverEquipped() and HasValidWeapon() then
                if wall and SilentTarget and SilentTarget.Character then
                    local thrp = SilentTarget.Character:FindFirstChild("HumanoidRootPart")
                    local lhrp = lplr.Character and lplr.Character:FindFirstChild("HumanoidRootPart")

                    if thrp and lhrp then
                        local distance = (thrp.Position - lhrp.Position).Magnitude
                        local maxDist = getgenv().Euleon["ExtendedBullet"]["MaxDistance"]

                        -- If gunMacroTarget is active, bypass wall check - position wall regardless
                        local shouldPositionWall = (gunMacroTarget and gunMacroTarget.Character) or (distance <= maxDist)

                        if shouldPositionWall then
                            local directionToTarget = (thrp.Position - lhrp.Position).Unit
                            wall.Position = lhrp.Position + directionToTarget * 20
                            wall.Size = getWallSize(distance)
                            wall.CanQuery = true

                            task.spawn(function()
                                game:GetService("RunService").RenderStepped:Wait()
                                if wall and wall.Parent then
                                    wall.CanQuery = false
                                end
                            end)
                        end
                    end
                end
            end
            
            local results = {orig_shoot(args)}
            local isRevolver = IsRevolverEquipped()
            
            local distance = 0
            if SilentTarget and SilentTarget.Character then
                local lhrp = lplr.Character and lplr.Character:FindFirstChild("HumanoidRootPart")
                local thrp = SilentTarget.Character:FindFirstChild("HumanoidRootPart")
                if lhrp and thrp then
                    distance = (thrp.Position - lhrp.Position).Magnitude
                end
            end
            
            -- If gunMacroTarget is active, ALWAYS redirect to CachedAimPart (ignore all checks)
            if gunMacroTarget and gunMacroTarget.Character and CachedAimPart and CachedAimPosition then
                if isRevolver then
                    local muz = args.ForcedOrigin
                        or (args.Handle and args.Handle:FindFirstChild("Muzzle") and args.Handle.Muzzle.WorldPosition)
                        or c.CFrame.Position
                    
                    results[1] = CachedAimPosition
                    results[2] = CachedAimPart
                    results[3] = (muz - CachedAimPosition).Unit
                else
                    -- Non-revolver: redirect to CachedAimPart
                    results[2] = CachedAimPart
                end
            elseif CachedAimPart then
                if isRevolver and CachedAimPosition and distance <= 263 then
                    local muz = args.ForcedOrigin
                        or (args.Handle and args.Handle:FindFirstChild("Muzzle") and args.Handle.Muzzle.WorldPosition)
                        or c.CFrame.Position
                    
                    results[1] = CachedAimPosition
                    results[2] = CachedAimPart
                    results[3] = (muz - CachedAimPosition).Unit
                elseif not isRevolver and distance <= 9999999 then
                    results[2] = CachedAimPart
                else
                end
            else
            end
            
            -- RESTORE CAMERA after firing
            if gunMacroTarget and gunMacroTarget.Character then
                c.CFrame = originalCFrame
            end
            
            -- Hitsound detection - ONLY play on actual shot hits
            if cfg_hitsound()["Enabled"] and results[2] and CachedAimPart and SilentTarget then
                local hitPart = results[2]
                local targetHumanoid = SilentTarget.Character:FindFirstChild("Humanoid")
                local currentTime = tick()
                
                -- Only play sound if we hit the actual target we're aiming at AND cooldown has passed
                if targetHumanoid and hitPart.Parent == SilentTarget.Character and (currentTime - lastHitsoundTime) > hitsoundCooldown then
                    lastHitsoundTime = currentTime
                    local sound = Instance.new("Sound")
                    sound.SoundId = "rbxassetid://" .. cfg_hitsound()["SoundID"]
                    sound.Volume = cfg_hitsound()["Volume"]
                    sound.Parent = c
                    game:GetService("Debris"):AddItem(sound, 1)
                    sound:Play()
                end
            end
            
            return table.unpack(results)
        end
        
        ClientBulletHooked = true
    end
    
    HookClientBullet()
    
    getgenv().Euleon_GunHandler = gun_handler
    getgenv().Euleon_GunHandlerOriginal = orig_shoot
 
    if gun_handler.getAim then
        local orig_get_aim = gun_handler.getAim
        gun_handler.getAim = function(p0, p1)
            local sc = getgenv().Euleon["Silent"]
            if not sc["Enabled"] or not sc["Main"]["Enabled"] then return orig_get_aim(p0,p1) end
            
            -- If gunMacroTarget is active, ALWAYS redirect regardless of FOV/visibility
            if gunMacroTarget and gunMacroTarget.Character and CachedAimPosition then
                if not IsRevolverEquipped() then
                    local dir = CachedAimPosition - p0
                    return dir.Unit, dir.Magnitude
                end
            end
            
            if not CachedAimPosition then return orig_get_aim(p0,p1) end
            
            if IsRevolverEquipped() then return orig_get_aim(p0,p1) end
            
            local dir = CachedAimPosition - p0
            return dir.Unit, dir.Magnitude
        end
    end
end


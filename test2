-- Chams Loop (Target Outline) - Using Highlight
table.insert(Euleon_Connections, rs.Heartbeat:Connect(function()
    if not cfg_visuals()["Chams"]["Enabled"] then
        -- Clean up highlight if Chams is disabled
        if lastChamsTarget and lastChamsTarget.Character then
            local highlight = lastChamsTarget.Character:FindFirstChild("ChamsHighlight")
            if highlight then
                pcall(function() highlight:Destroy() end)
            end
        end
        lastChamsTarget = nil
        return
    end
    
    -- Get current target - only if it's valid and locked
    local currentTarget = nil
    
    if SilentTarget and SilentTarget.Character then
        local targetHRP = SilentTarget.Character:FindFirstChild("HumanoidRootPart")
        local targetHumanoid = SilentTarget.Character:FindFirstChild("Humanoid")
        local lhrp = lplr.Character and lplr.Character:FindFirstChild("HumanoidRootPart")
        
        -- Verify target is actually valid
        if targetHRP and targetHumanoid and lhrp and targetHumanoid.Health > 0 then
            local distance = (targetHRP.Position - lhrp.Position).Magnitude
            
            -- Check if target is in valid range and locked
            if distance <= 300 and CachedAimPart then
                currentTarget = SilentTarget
            end
        end
    end
    
    -- Clean up old target if changed
    if lastChamsTarget ~= currentTarget then
        if lastChamsTarget and lastChamsTarget.Character then
            local highlight = lastChamsTarget.Character:FindFirstChild("ChamsHighlight")
            if highlight then
                pcall(function() highlight:Destroy() end)
            end
        end
        lastChamsTarget = currentTarget
    end
    
    -- Apply highlight to current valid target only
    if currentTarget and currentTarget.Character then
        if not currentTarget.Character:FindFirstChild("ChamsHighlight") then
            local highlight = Instance.new("Highlight")
            highlight.Name = "ChamsHighlight"
            highlight.FillColor = cfg_visuals()["Chams"]["Color"]
            highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
            highlight.FillTransparency = 0.5
            highlight.OutlineTransparency = 0.1
            highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            highlight.Adornee = currentTarget.Character
            highlight.Parent = currentTarget.Character
        end
    end
end))


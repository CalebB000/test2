            end
        end
    end))
    
    table.insert(Euleon_Connections, rs.Heartbeat:Connect(function()
        if ik_cooldown > 0 then
            ik_cooldown = ik_cooldown - 1
        end
        
        if last_shot_time > 0 then
            last_shot_time = last_shot_time + 1
            if last_shot_time > 15 and cfg_misc()["GunMacro"]["PutAwayAfterShot"] then
                local backpack = lplr:FindFirstChild("Backpack")
                if backpack and lplr.Character then
                    local db = lplr.Character:FindFirstChild("[Double-Barrel SG]")
                    local tac = lplr.Character:FindFirstChild("[TacticalShotgun]")
                    local knife = lplr.Character:FindFirstChild("[Knife]")
                    if db then pcall(function() db.Parent = backpack end) end
                    if tac then pcall(function() tac.Parent = backpack end) end
                    if knife then pcall(function() knife.Parent = backpack end) end
                end
                last_shot_time = 0
                ik_executing = false
            end
        end
        
        -- Handle Hold mode - continuous auto-shoot when in range (OPTIMIZED)
        if cfg_misc()["GunMacro"]["Mode"] == "Hold" and (ik_holding or ik_executing) then
            
            -- CRITICAL: Check if current target is alive (K.O check)
            if gunMacroTarget and gunMacroTarget.Character then
                local targetHum = gunMacroTarget.Character:FindFirstChildOfClass("Humanoid")
                if not targetHum or targetHum.Health <= 0 then
                    ik_executing = false
                    gunMacroTarget = nil
                    return
                end
                if targetHum:GetState() == Enum.HumanoidStateType.Dead then
                    ik_executing = false
                    gunMacroTarget = nil
                    return
                end
                
                -- Check BodyEffects for K.O and Dead states (extra safety)
                local bodyEffects = gunMacroTarget.Character:FindFirstChild("BodyEffects")
                if bodyEffects then
                    local koValue = bodyEffects:FindFirstChild("K.O")
                    local deadValue = bodyEffects:FindFirstChild("Dead")
                    if (koValue and koValue.Value) or (deadValue and deadValue.Value) then
                        ik_executing = false
                        gunMacroTarget = nil
                        return
                    end
                end
            end
            
            local noVisibleLimits = cfg_misc()["GunMacro"]["NoVisibleLimits"]
            
            -- If NoVisibleLimits, find closest ESPed player by distance every frame (like AutoShoot)
            if noVisibleLimits then
                if not lplr.Character then 
                    ik_executing = false
                    return 
                end
                
                local lhrp = lplr.Character:FindFirstChild("HumanoidRootPart")
                if not lhrp then 
                    ik_executing = false
                    return 
                end
                
                local closeRange = cfg_misc()["GunMacro"]["Range"]
                local bestTarget = nil
                local bestDist = closeRange
                
                -- Loop through ESPed players and find closest in range
                for _, espName in ipairs(_G.ESPFilteredPlayers) do
                    local player = plrs:FindFirstChild(espName)
                    if not player or not player.Character then continue end
                    
                    local thrp = player.Character:FindFirstChild("HumanoidRootPart")
                    if not thrp then continue end
                    
                    -- Check if alive using IsAlive function (proper K.O check)
                    if not IsAlive(player) then continue end
                    
                    -- Check wallcheck if enabled
                    if getgenv().Euleon["Checks"]["WallCheck"] then
                        if not CamlockWallCheck(player) then continue end
                    end
                    
                    -- Find closest ESPed player by distance
                    local distance = (thrp.Position - lhrp.Position).Magnitude
                    if distance <= bestDist then
                        bestDist = distance
                        bestTarget = player
                    end
                end
                
                if bestTarget and bestTarget.Character then
                    SilentTarget = bestTarget
                    gunMacroTarget = bestTarget
                    
                    -- Update aim part for this target
                    local targetPartName = "Head"
                    if shots_fired >= 1 then
                        targetPartName = "UpperTorso"
                    end
                    local targetPart = bestTarget.Character:FindFirstChild(targetPartName)
                    if targetPart then
                        CachedAimPart = targetPart
                    end
                    
                    if not ik_executing then
                        ik_executing = true
                        gun_index = 1
                        last_shot_time = 0
                        shots_fired = 0
                        
                        local backpack = lplr:FindFirstChild("Backpack")
                        local character = lplr.Character
                        if backpack and character then
                            local currentTool = character:FindFirstChildOfClass("Tool")
                            if currentTool then
                                pcall(function() currentTool.Parent = backpack end)
                            end
                        end
                    end
                else
                    -- Only set to false if we were previously executing (lost target)
                    if ik_executing then
                        ik_executing = false
                    end
                end
                -- DON'T RETURN - let gun pulling code run below
            else
                -- Normal Hold mode (with FOV checks)
                if ik_holding then
                    UpdateCachedAim()
                end
                
                if not lplr.Character then 
                    ik_executing = false
                    return 
                end
                
                if not SilentTarget or not SilentTarget.Character then 
                    ik_executing = false
                    return 
                end
                
                -- Check if SilentTarget is still alive (K.O check)
                local targetHum = SilentTarget.Character:FindFirstChildOfClass("Humanoid")
                if not targetHum or targetHum.Health <= 0 then
                    ik_executing = false
                    return
                end
                if targetHum:GetState() == Enum.HumanoidStateType.Dead then
                    ik_executing = false
                    return
                end
                
                -- Check BodyEffects for K.O and Dead states (extra safety)
                local bodyEffects = SilentTarget.Character:FindFirstChild("BodyEffects")
                if bodyEffects then
                    local koValue = bodyEffects:FindFirstChild("K.O")
                    local deadValue = bodyEffects:FindFirstChild("Dead")
                    if (koValue and koValue.Value) or (deadValue and deadValue.Value) then
                        ik_executing = false
                        return
                    end
                end
                
                local lhrp = lplr.Character:FindFirstChild("HumanoidRootPart")
                local thrp = SilentTarget.Character:FindFirstChild("HumanoidRootPart")
                if not lhrp or not thrp then 
                    ik_executing = false
                    return 
                end
                
                local distance = (thrp.Position - lhrp.Position).Magnitude
                local closeRange = cfg_misc()["GunMacro"]["Range"]
                
                if distance > closeRange and not IsRevolverEquipped() then
                    if ik_executing then
                        ik_executing = false
                        gun_index = 1
                        last_shot_time = 0
                        shots_fired = 0
                    end
                    return
                end
                
                -- OnlyESPED: Always check if enabled
                if cfg_misc()["GunMacro"]["OnlyESPED"] then
                    if not IsPlayerESPed(SilentTarget) then 
                        ik_executing = false
                        return 
                    end
                end
                
                -- K.O Check: Always check humanoid health
                local targetHum = SilentTarget.Character:FindFirstChildOfClass("Humanoid")
                if not targetHum or targetHum.Health <= 0 then 
                    ik_executing = false
                    return 
                end
                if targetHum:GetState() == Enum.HumanoidStateType.Dead then 
                    ik_executing = false
                    return 
                end
                
                if not ik_executing then
                    ik_executing = true
                    gunMacroTarget = SilentTarget
                    gun_index = 1
                    last_shot_time = 0
                    shots_fired = 0
                    
                    local backpack = lplr:FindFirstChild("Backpack")
                    local character = lplr.Character
                    if backpack and character then
                        local currentTool = character:FindFirstChildOfClass("Tool")
                        if currentTool then
                            pcall(function() currentTool.Parent = backpack end)
                        end
                    end
                end
            end
        end
        
        if not ik_executing then return end
        if not lplr or not lplr.Character then return end
        
        -- CRITICAL: If gunMacroTarget is set (NoVisibleLimits mode), update aim immediately
        if gunMacroTarget and gunMacroTarget.Character then
            local targetPartName = "Head"
            if shots_fired >= 1 then
                targetPartName = "UpperTorso"
            end
            local targetPart = gunMacroTarget.Character:FindFirstChild(targetPartName)
            if targetPart then
                CachedAimPart = targetPart
            end
        end
        
        -- Only apply 2-shot limit for Click mode, not Hold mode
        if cfg_misc()["GunMacro"]["Mode"] ~= "Hold" and shots_fired >= 2 then
            ik_executing = false
            ik_cooldown = 10
            return
        end
        
        -- Only apply 2-shot limit for Click mode
        if cfg_misc()["GunMacro"]["Mode"] ~= "Hold" and shots_fired >= 2 then
            ik_executing = false
            gunMacroTarget = nil  -- Clear gun macro target
            ik_cooldown = 10
            return
        end
        
        local closest_player = nil
        
        -- If gunMacroTarget is set (gun macro is firing), use that
        if gunMacroTarget and gunMacroTarget.Character then
            closest_player = gunMacroTarget
        else
            -- Otherwise, find closest ESPed player to cursor (normal gun pulling)
            local closest_dist = math.huge
            local mousePos = uis:GetMouseLocation()
            
            for _, player in pairs(GetPlayers()) do
                if player == lplr then continue end
                if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then continue end
                if not IsPlayerESPed(player) then continue end
                
                local screenPos = c:WorldToViewportPoint(player.Character.HumanoidRootPart.Position)
                if screenPos.Z <= 0 then continue end
                
                local cursor_dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                if cursor_dist < closest_dist then
                    closest_dist = cursor_dist
                    closest_player = player
                end
            end
        end
        
        if not closest_player then return end
        
        local targetPartName = "Head"
        if shots_fired >= 1 then
            targetPartName = "UpperTorso"
        end
        
        local targetPart = closest_player.Character:FindFirstChild(targetPartName)
        if targetPart then
            CachedAimPart = targetPart
        end
        
        local gun_name = gun_sequence[gun_index]
        local backpack = lplr:FindFirstChild("Backpack")
        if not backpack then return end

        -- Put away current gun before bringing out new one (Da Hood only - has gun swap cooldown)
        local current_gun_name = gun_sequence[gun_index - 1]
        if gun_index > 1 and current_gun_name then
            local current_gun = lplr.Character:FindFirstChild(current_gun_name)
            if current_gun then
                pcall(function() current_gun.Parent = backpack end)
                -- Add delay for Da Hood gun swap cooldown (Der Hood doesn't need delay)
                if isDaHood then
                    task.wait(getgenv().Euleon["DaHoodPullOutDelay"] or 0.2)
                end
            end
        end

        -- Pull out new gun
        local gun_in_char = lplr.Character:FindFirstChild(gun_name)
        if gun_in_char then
            pcall(function() gun_in_char.Parent = backpack end)
        end

        local gun = backpack:FindFirstChild(gun_name)
        if gun then
            pcall(function() gun.Parent = lplr.Character end)
            pcall(function() gun:Activate() end)  -- Fire immediately without wait

            shots_fired = shots_fired + 1
            last_shot_time = 1
            gun_index = gun_index + 1
        end
    end))
end


-- AutoShoot: Automatically shoot ESPed players within range (ignores FOV and visibility)
if cfg_misc()["AutoShoot"]["Enabled"] then
    local autoShootCurrentTarget = nil
    
    table.insert(Euleon_Connections, rs.Heartbeat:Connect(function()
        if not lplr or not lplr.Character then return end
        
        local lhrp = lplr.Character:FindFirstChild("HumanoidRootPart")
        if not lhrp then return end
        
        local autoShootRange = cfg_misc()["AutoShoot"]["Range"]
        local autoShootTarget = nil
        local closestAutoShootDist = autoShootRange
        
        -- Find closest ESPed player within range
        for _, espPlayerName in ipairs(_G.ESPFilteredPlayers) do
            local player = plrs:FindFirstChild(espPlayerName)
            if not player then continue end
            
            if not player.Character then continue end
            
            local thrp = player.Character:FindFirstChild("HumanoidRootPart")
            if not thrp then continue end
            
            -- Check if alive
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            if not humanoid or humanoid.Health <= 0 then continue end
            
            -- Find closest ESPed player
            local distance = (thrp.Position - lhrp.Position).Magnitude
            if distance <= closestAutoShootDist then
                closestAutoShootDist = distance
                autoShootTarget = player
            end
        end
        
        -- Update autoShoot target (only ESPed players in range)
        autoShootCurrentTarget = autoShootTarget
        
        -- If found living ESPed player in range, set as target and shoot
        if autoShootCurrentTarget and autoShootCurrentTarget.Character then
            -- Double check they're still alive right before shooting
            local targetHumanoid = autoShootCurrentTarget.Character:FindFirstChildOfClass("Humanoid")
            if targetHumanoid and targetHumanoid.Health > 0 then
                SilentTarget = autoShootCurrentTarget
                CachedAimPart = autoShootCurrentTarget.Character:FindFirstChild("Head") or autoShootCurrentTarget.Character:FindFirstChild("UpperTorso")
                if CachedAimPart then
                    if getgenv().Euleon["Checks"]["WallCheck"] then
                        if CamlockWallCheck(autoShootCurrentTarget) then
                            CachedAimPosition = CachedAimPart.Position
                        else
                            CachedAimPosition = nil
                        end
                    else
                        CachedAimPosition = CachedAimPart.Position
                    end
                else
                    CachedAimPosition = nil
                end
                
                local currentTool = lplr.Character:FindFirstChildOfClass("Tool")
                if currentTool then
                    pcall(function()
                        currentTool:Activate()
                    end)
                end
            else
                -- Target is dead, clear everything
                SilentTarget = nil
                CachedAimPart = nil
                CachedAimPosition = nil
            end
        else
            -- No valid ESPed target in range, clear everything
            SilentTarget = nil
            CachedAimPart = nil
            CachedAimPosition = nil
        end
    end))
end


if getgenv().Euleon["AnimationPack"]["Enabled"] and getgenv().Euleon["AnimationPack"]["Greet"]["Enabled"] then
    local greetAnimationTrack = nil
    local isGreeting = false
    local greetKey = getgenv().Euleon["AnimationPack"]["Greet"]["Key"]
    local greetAnimationId = getgenv().Euleon["AnimationPack"]["Greet"]["AnimationId"]
    local greetPullKnife = getgenv().Euleon["AnimationPack"]["Greet"]["PullOutKnife"]
    
    local function pullOutKnifeFunc()
        local backpack = lplr:FindFirstChild("Backpack")
        local character = lplr.Character
        
        if not backpack or not character then return end
        
        local currentTool = character:FindFirstChildOfClass("Tool")
        if currentTool then
            currentTool.Parent = backpack
            task.wait(0.1)
        end
        
        local knifeInCharacter = character:FindFirstChild("[Knife]")
        if knifeInCharacter then
            knifeInCharacter.Parent = backpack
            task.wait(0.1)
        end
        
        local knifeInBackpack = backpack:FindFirstChild("[Knife]")
        if knifeInBackpack then
            knifeInBackpack.Parent = character
            task.wait(0.05)
        end
    end
    
    local function playGreetAnimation()
        if not lplr.Character then return end
        
        local humanoid = lplr.Character:FindFirstChild("Humanoid")
        if not humanoid then return end
        
        if greetAnimationTrack then
            greetAnimationTrack:Stop()
        end
        
        local animation = Instance.new("Animation")
        animation.AnimationId = greetAnimationId
        
        greetAnimationTrack = humanoid:LoadAnimation(animation)
        greetAnimationTrack:Play()
        isGreeting = true
    end
    
    local function stopGreetAnimation()
        if greetAnimationTrack and isGreeting then
            greetAnimationTrack:Stop()
            isGreeting = false
        end
    end
    
    table.insert(Euleon_Connections, uis.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == greetKey then
            playGreetAnimation()
            if greetPullKnife then
                pullOutKnifeFunc()
            end
        end
    end))
    
    table.insert(Euleon_Connections, uis.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == Enum.KeyCode.W or
           input.KeyCode == Enum.KeyCode.A or
           input.KeyCode == Enum.KeyCode.S or
           input.KeyCode == Enum.KeyCode.D or
           input.KeyCode == Enum.KeyCode.Space then
            stopGreetAnimation()
        end
    end))
    
    if lplr.Character and lplr.Character:FindFirstChild("Humanoid") then
        table.insert(Euleon_Connections, lplr.Character:FindFirstChild("Humanoid").StateChanged:Connect(function(oldState, newState)
            if isGreeting then
                if newState == Enum.HumanoidStateType.Running or
                   newState == Enum.HumanoidStateType.Jumping or
                   newState == Enum.HumanoidStateType.Freefall then
                    stopGreetAnimation()
                end
            end
        end))
    end
    
    table.insert(Euleon_Connections, lplr.CharacterAdded:Connect(function(newCharacter)
        greetAnimationTrack = nil
        isGreeting = false
        
        local humanoid = newCharacter:FindFirstChild("Humanoid")
        if humanoid then
            table.insert(Euleon_Connections, humanoid.StateChanged:Connect(function(oldState, newState)
                if isGreeting then
                    if newState == Enum.HumanoidStateType.Running or
                       newState == Enum.HumanoidStateType.Jumping or
                       newState == Enum.HumanoidStateType.Freefall then
                        stopGreetAnimation()
                    end
                end
            end))
        end
    end))
    
end





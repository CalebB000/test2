-- TriggerBot Implementation (Identical to standalone - direct and reliable)
local triggerBotPressed = false
if getgenv().Euleon["TriggerBot"]["Enabled"] then
    table.insert(Euleon_Connections, rs.RenderStepped:Connect(function()
        if not getgenv().Euleon["TriggerBot"]["Enabled"] then
            if triggerBotPressed then
                triggerBotPressed = false
                mouse1release()
            end
            return
        end

        -- Check if hold key is pressed (support both KeyCode and UserInputType)
        local holdKey = getgenv().Euleon["TriggerBot"]["HoldKey"]
        local keyPressed = false

        if holdKey == Enum.UserInputType.MouseButton1 or holdKey == Enum.UserInputType.MouseButton2 then
            keyPressed = uis:IsMouseButtonPressed(holdKey)
        else
            -- Assume it's a KeyCode
            keyPressed = uis:IsKeyDown(holdKey)
        end

        if not keyPressed then
            if triggerBotPressed then
                triggerBotPressed = false
                mouse1release()
            end
            return
        end

        local target = mouse.Target
        if not target then
            if triggerBotPressed then
                triggerBotPressed = false
                mouse1release()
            end
            return
        end

        local char = target:FindFirstAncestorOfClass("Model")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local targetPlayer = char and plrs:GetPlayerFromCharacter(char)

        if not hum or hum.Health <= 0 or targetPlayer == lplr then
            if triggerBotPressed then
                triggerBotPressed = false
                mouse1release()
            end
            return
        end

        -- Check if whitelisted
        for _, whitelistedName in pairs(_G.ESPWhitelistedPlayers) do
            if targetPlayer.Name == whitelistedName then
                if triggerBotPressed then
                    triggerBotPressed = false
                    mouse1release()
                end
                return
            end
        end

        -- Check team if enabled
        if getgenv().Euleon["TriggerBot"]["TeamCheck"] and targetPlayer.Team == lplr.Team then
            if triggerBotPressed then
                triggerBotPressed = false
                mouse1release()
            end
            return
        end

        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then
            if triggerBotPressed then
                triggerBotPressed = false
                mouse1release()
            end
            return
        end

        -- Distance check
        local lhrp = lplr.Character and lplr.Character:FindFirstChild("HumanoidRootPart")
        if not lhrp or (root.Position - lhrp.Position).Magnitude > getgenv().Euleon["TriggerBot"]["MaxDistance"] then
            if triggerBotPressed then
                triggerBotPressed = false
                mouse1release()
            end
            return
        end

        -- Visible check
        if getgenv().Euleon["TriggerBot"]["VisibleCheck"] then
            if not CamlockWallCheck(targetPlayer) then
                if triggerBotPressed then
                    triggerBotPressed = false
                    mouse1release()
                end
                return
            end
        end

        -- All checks passed - hold down mouse button to shoot continuously
        if not triggerBotPressed then
            triggerBotPressed = true
            mouse1press()
        end
    end))
end


        versionText.BackgroundTransparency = 1
        versionText.BorderSizePixel = 0
        versionText.TextColor3 = Color3.fromRGB(0, 0, 0)
        versionText.TextSize = 36
        versionText.Font = Enum.Font.GothamBold
        versionText.TextTransparency = 1
        versionText.Parent = screenGui
        
        -- Add teal outline to V3 only
        local textStroke = Instance.new("UIStroke")
        textStroke.Color = Color3.fromRGB(5, 160, 173)
        textStroke.Thickness = 1.9
        textStroke.Transparency = 1
        textStroke.Parent = versionText
        
        local motionBlur = Instance.new("BlurEffect")
        motionBlur.Size = 0
        motionBlur.Parent = c
        
        -- play audio
        local introSound = Instance.new("Sound")
        introSound.SoundId = "rbxassetid://138890398994853"
        introSound.Volume = 2
        introSound.Parent = workspace
        
        local cleanupDone = false
        
        -- Cleanup function
        local function DoCleanup()
            if cleanupDone then return end
            cleanupDone = true
            pcall(function() screenGui:Destroy() end)
            pcall(function() motionBlur:Destroy() end)
            pcall(function() introSound:Destroy() end)
        end
        
        task.wait(0.2)
        introSound:Play()
        
        -- Fade in logo and shadow (2 seconds at 60fps)
        for i = 0, 119 do
            if not screenGui.Parent then DoCleanup() return end  -- Check if GUI was destroyed
            
            local progress = i / 120
            logoLabel.ImageTransparency = 1 - progress
            shadowLabel.ImageTransparency = 1 - progress * 0.4
            motionBlur.Size = progress * 25
            
            -- Text slides in and fades after 1 second
            if i >= 60 then
                local slideProgress = (i - 60) / 60
                versionText.Position = UDim2.new(0.5, 150 - (slideProgress * 100), 0.5, 35)
                versionText.TextTransparency = 1 - slideProgress
                textStroke.Transparency = 1 - slideProgress
            end
            
            task.wait(1/60)
        end
        
        if not screenGui.Parent then DoCleanup() return end
        
        -- Ensure final state
        logoLabel.ImageTransparency = 0
        shadowLabel.ImageTransparency = 0.6
        versionText.Position = UDim2.new(0.5, 50, 0.5, 35)
        versionText.TextTransparency = 0
        textStroke.Transparency = 0
        
        -- Hold (2 seconds)
        task.wait(2)
        
        if not screenGui.Parent then DoCleanup() return end
        
        -- Fade out everything (1.5 seconds at 60fps)
        for i = 0, 89 do
            if not screenGui.Parent then DoCleanup() return end
            
            local progress = i / 90
            logoLabel.ImageTransparency = progress
            shadowLabel.ImageTransparency = 0.6 + progress * 0.4
            versionText.TextTransparency = progress
            textStroke.Transparency = progress
            motionBlur.Size = (1 - progress) * 25
            introSound.Volume = 2 * (1 - progress)
            
            task.wait(1/60)
        end
        
        DoCleanup()
    end
    
    pcall(function()
        ShowIntro()
    end)
end


if cfg_misc()["GunMacro"]["Enabled"] then
    local ik_cooldown = 0
    local gun_sequence = {"[Double-Barrel SG]", "[TacticalShotgun]", "[Double-Barrel SG]", "[TacticalShotgun]"}
    local gun_index = 1
    local last_shot_time = 0
    local shots_fired = 0
    local ik_executing = false
    local ik_holding = false  -- For Hold mode
    
    table.insert(Euleon_Connections, lplr.CharacterAdded:Connect(function(char)
        task.wait(0.1)
        ik_cooldown = 0
        ik_executing = false
        ik_holding = false
        gun_index = 1
        last_shot_time = 0
        shots_fired = 0
        SilentTarget = nil
        CachedAimPart = nil
        CachedAimPosition = nil
    end))
    
    -- Check if player is ESPed
    local function IsPlayerESPed(player)
        if not cfg_misc()["GunMacro"]["OnlyESPED"] then return true end
        for _, espName in ipairs(_G.ESPFilteredPlayers) do
            if plrs:FindFirstChild(espName) == player then
                return true
            end
        end
        return false
    end
    
    table.insert(Euleon_Connections, uis.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.UserInputType == Enum.UserInputType.MouseButton3 then
            if cfg_misc()["GunMacro"]["Mode"] == "Hold" then
                -- Hold mode: just activate listening, don't validate yet
                ik_holding = true
            else  -- Click mode
                if ik_executing or ik_cooldown > 0 then return end
                
                local noVisibleLimits = cfg_misc()["GunMacro"]["NoVisibleLimits"]
                
                -- If NoVisibleLimits, find target by distance only
                if noVisibleLimits then
                    local lhrp = lplr.Character and lplr.Character:FindFirstChild("HumanoidRootPart")
                    if not lhrp then return end
                    
                    local closeRange = cfg_misc()["GunMacro"]["Range"]
                    local bestTarget = nil
                    local bestDist = closeRange
                    
                    -- Find closest ESPed player in range (if OnlyESPED)
                    if cfg_misc()["GunMacro"]["OnlyESPED"] then
                        for _, espName in ipairs(_G.ESPFilteredPlayers) do
                            local player = plrs:FindFirstChild(espName)
                            if not player or not player.Character then continue end
                            
                            local thrp = player.Character:FindFirstChild("HumanoidRootPart")
                            if not thrp then continue end
                            
                            -- Check if alive (proper K.O check using IsAlive)
                            if not IsAlive(player) then continue end
                            
                            -- Check wallcheck if enabled
                            if getgenv().Euleon["Checks"]["WallCheck"] then
                                if not CamlockWallCheck(player) then continue end
                            end
                            
                            local dist = (thrp.Position - lhrp.Position).Magnitude
                            if dist < bestDist then
                                bestDist = dist
                                bestTarget = player
                            end
                        end
                    else
                        -- Find closest any player in range
                        for _, player in ipairs(plrs:GetPlayers()) do
                            if player == lplr or not player.Character then continue end
                            
                            local thrp = player.Character:FindFirstChild("HumanoidRootPart")
                            if not thrp then continue end
                            
                            -- Check if alive (proper K.O check using IsAlive)
                            if not IsAlive(player) then continue end
                            
                            -- Check wallcheck if enabled
                            if getgenv().Euleon["Checks"]["WallCheck"] then
                                if not CamlockWallCheck(player) then continue end
                            end
                            
                            local dist = (thrp.Position - lhrp.Position).Magnitude
                            if dist < bestDist then
                                bestDist = dist
                                bestTarget = player
                            end
                        end
                    end
                    
                    if not bestTarget then return end
                    
                    -- Update aim part for this target
                    local targetPartName = "Head"
                    if shots_fired >= 1 then
                        targetPartName = "UpperTorso"
                    end
                    local targetPart = bestTarget.Character:FindFirstChild(targetPartName)
                    if targetPart then
                        CachedAimPart = targetPart
                    end
                    
                    SilentTarget = bestTarget
                    gunMacroTarget = bestTarget
                    ik_executing = true
                    gun_index = 1
                    last_shot_time = 0
                    shots_fired = 0
                    
                    local backpack = lplr:FindFirstChild("Backpack")
                    local character = lplr.Character
                    if backpack and character then
                        local currentTool = character:FindFirstChildOfClass("Tool")
                        if currentTool then
                            pcall(function() currentTool.Parent = backpack end)
                        end
                    end
                    return
                end
                
                -- Normal mode with FOV/visibility checks
                UpdateCachedAim()
                
                if not SilentTarget or not SilentTarget.Character then return end
                
                -- OnlyESPED: Always check if enabled
                if cfg_misc()["GunMacro"]["OnlyESPED"] then
                    if not IsPlayerESPed(SilentTarget) then return end
                end
                
                -- K.O Check: Always check humanoid health
                local targetHum = SilentTarget.Character:FindFirstChildOfClass("Humanoid")
                if not targetHum or targetHum.Health <= 0 then return end
                if targetHum:GetState() == Enum.HumanoidStateType.Dead then return end
                
                local lhrp = lplr.Character and lplr.Character:FindFirstChild("HumanoidRootPart")
                local thrp = SilentTarget.Character:FindFirstChild("HumanoidRootPart")
                if not lhrp or not thrp then return end
                
                local distance = (thrp.Position - lhrp.Position).Magnitude
                local closeRange = cfg_misc()["GunMacro"]["Range"]
                if distance > closeRange and not IsRevolverEquipped() then
                    return
                end
                
                -- FOV Check
                local fov_config = getgenv().Euleon["Silent"]["FOV"]
                local fov_radius = fov_config["Radius"]
                local screen_pos = c:WorldToViewportPoint(thrp.Position)
                local mouse_pos = uis:GetMouseLocation()
                local dist_to_mouse = (Vector2.new(screen_pos.X, screen_pos.Y) - mouse_pos).Magnitude
                
                if dist_to_mouse > fov_radius then return end
                
                ik_executing = true
                gunMacroTarget = SilentTarget  -- Lock silent aim to gun macro target
                gun_index = 1
                last_shot_time = 0
                shots_fired = 0
                
                local backpack = lplr:FindFirstChild("Backpack")
                local character = lplr.Character
                if backpack and character then
                    local currentTool = character:FindFirstChildOfClass("Tool")
                    if currentTool then
                        pcall(function() currentTool.Parent = backpack end)
                    end
                end
            end
        end
    end))
    
    table.insert(Euleon_Connections, uis.InputEnded:Connect(function(input, gameProcessed)

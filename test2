local function getWallSize(distance)
    if not distance then distance = 65 end
    if not getgenv().Euleon or not getgenv().Euleon["ExtendedBullet"] then
        return Vector3.new(20, 40, 20)
    end
    
    local maxDist = getgenv().Euleon["ExtendedBullet"]["MaxDistance"] or 65
    local buffer = 20
    local baseSize = Vector3.new(20, 40, 20)
    
    -- Calculate scale, but clamp to minimum 0.2 instead of 0 to handle close range (teleport)
    local scale = (distance - buffer) / (maxDist - buffer)
    if scale < 0.2 then scale = 0.2 end  -- Minimum size of 0.2 scale instead of 0
    if scale > 1 then scale = 1 end      -- Cap at 1 for max size
    
    return Vector3.new(baseSize.X * scale, baseSize.Y * scale, baseSize.Z * scale)
end

local function createWall()
    if wall then return end
    wall = Instance.new("Part")
    wall.Name = "ExtendedBullet"
    wall.Shape = Enum.PartType.Block
    wall.Size = getWallSize()
    wall.Color = Color3.fromRGB(255, 0, 0)
    wall.Material = Enum.Material.Neon
    wall.CanCollide = false
    wall.CanQuery = true
    wall.Anchored = true
    wall.Parent = workspace
end

local function removeWall()

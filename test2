        if world_dist > max_range then continue end
        
        local isWhitelisted = false
        for _, whitelistedName in pairs(_G.ESPWhitelistedPlayers) do
            if whitelistedName == player.Name then
                isWhitelisted = true
                break
            end
        end
        if isWhitelisted then continue end
        
        local screenPos, onScreen = WorldToScreen(target_pos)
        if not onScreen then continue end
        
        if world_dist < closestDist then
            closestDist = world_dist
            closestPlayer = player
        end
    end
    
    if not closestPlayer then
    end
    
    return closestPlayer
end

local function SanitizeDisplayName(displayName)
    local sanitized = displayName:gsub("[^%w%s%p]", ""):gsub("^%s+", ""):gsub("%s+$", "")
    
    if sanitized == "" or sanitized:len() == 0 then
        return "???"
    end
    
    return sanitized
end

-- Camlock-specific wall check (doesn't use Silent settings)
local function CamlockWallCheck(player)
    if not player.Character then return false end
    
    local hrp = player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    
    local excludeList = {lplr.Character}
    for _, p in pairs(GetAllPlayers()) do
        if p.Character then
            table.insert(excludeList, p.Character)
        end
    end
    
    if wall then
        table.insert(excludeList, wall)
    end
    
    for _, w in ipairs(wall_parts) do
        if w then
            table.insert(excludeList, w)
        end
    end
    
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = excludeList
    
    local origin = c.CFrame.Position
    local direction = (hrp.Position - origin)
    local result = workspace:Raycast(origin, direction, rayParams)
    
    if not result then return true end
    
    return result.Instance:IsDescendantOf(player.Character)
end

local function GetSilentAimPart(player)
    if not player.Character then return nil end
    
    local mousePos = uis:GetMouseLocation()
    local cfg = cfg_silent()
    if not cfg then return nil end
    
    local closestMode = cfg["ClosestMode"]
    local mode = closestMode and closestMode["Mode"] or "part"
    
    local parts = {"Head", "UpperTorso", "LowerTorso", "LeftUpperArm", "RightUpperLeg"}
    
    -- Handle different modes
    if mode == "HeadOnly" then
        parts = {"Head"}
    elseif mode == "minimal" then
        parts = {"Head", "UpperTorso", "LowerTorso", "LeftUpperArm", "RightUpperLeg"}
    end
    
    local closest_part = nil
    local closest_dist = math.huge
    
    for _, part_name in ipairs(parts) do
        local part = player.Character:FindFirstChild(part_name)
        if part and part:IsA("BasePart") then
            local screenPos = c:WorldToViewportPoint(part.Position)
            if screenPos.Z > 0 then
                local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                if dist < closest_dist then
                    closest_dist = dist
                    closest_part = part
                end
            end
        end
    end
    
    return closest_part
end


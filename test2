local function UpdateCachedAim()
    CachedAimPart = nil
    CachedAimPosition = nil
    closestPlayerRef = nil
    
    if not getgenv().Euleon["Silent"]["Enabled"] or not getgenv().Euleon["Silent"]["Main"]["Enabled"] then
        return
    end
    
    if cfg_misc()["AutoShoot"]["Enabled"] then
        return
    end
    
    fov_throttle = (fov_throttle + 1) % 2
    if fov_throttle == 0 then
        if ik_executing and gunMacroTarget then
            SilentTarget = gunMacroTarget
        elseif _G.TargetESPedPlayersMode then
            SilentTarget = GetClosestESPedPlayer()
            if not SilentTarget then
                SilentTarget = GetClosestPlayerInFOV()
            end
        else
            SilentTarget = GetClosestPlayerInFOV()
        end
    end
    
    if not SilentTarget or not SilentTarget.Character then
        return
    end
    
    local part = GetSilentAimPart(SilentTarget)
    if not part then
        return
    end
    
    if getgenv().Euleon["Checks"]["WallCheck"] then
        local wallCheckResult = CamlockWallCheck(SilentTarget)
        if not wallCheckResult then
            return
        end
    end
    
    if not HasValidWeapon() then
        return
    end
    
    if not IsRevolverEquipped() then
        local lhrp = lplr.Character and lplr.Character:FindFirstChild("HumanoidRootPart")
        local thrp = SilentTarget.Character:FindFirstChild("HumanoidRootPart")
        if lhrp and thrp then
            local distance = (thrp.Position - lhrp.Position).Magnitude
            if distance > getgenv().Euleon["ExtendedBullet"]["MaxDistance"] then
                return
            end
        end
    end
    
    CachedAimPart = part
    CachedAimPosition = part.Position
    
    if getgenv().Euleon["Silent"]["Main"]["Prediction"]["Enabled"] then
        pcall(function()
            local vel = GetVelocity(SilentTarget.Character)
            if vel then
                CachedAimPosition = CachedAimPosition + (vel * getgenv().Euleon["Silent"]["Main"]["Prediction"]["Value"])
            end
        end)
    end
    
    SilentTargetVisible = true
    closestPlayerRef = SilentTarget
end

